{
    "name": "Correctness.Sum",
    "type": "correctness",
    "tests": [
        {
            "name": "small_positive",
            "input":  { "array": [1, 2, 3, 4, 5], "require_positive": true },
            "output": { "sum": 15, "max": 5, "ok": true }
        },
        {
            "name": "with_negatives",
            "input":  { "array": [3, -1, 4, -1, 5, -9, 2, 6], "require_positive": false },
            "output": { "sum": 9, "max": 6, "ok": true }
        },
        {
            "name": "negatives_strict",
            "input":  { "array": [3, -1, 4, 1, 5], "require_positive": true },
            "output": { "sum": 12, "max": 5, "ok": false }
        }
    ]
}
