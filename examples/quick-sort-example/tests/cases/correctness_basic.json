    "tests": [
        {
            "name": "small_sort",
            "input": { "array": [5, 3, 1, 4, 2] },
            "output": { "result": [1, 2, 3, 4, 5] }
        },
        {
            "name": "already_sorted",
            "input": { "array": [1, 2, 3] },
            "output": { "result": [1, 2, 3] }
        },
        {
            "name": "single_element",
            "input": { "array": [42] },
            "output": { "result": [42] }
        },
        {
            "name": "empty_array",
            "input": { "array": [] },
            "output": { "result": [] }
        }
    ]
}
